# Database Configuration
# For local development (running app outside Docker):
DATABASE_URL="postgresql://admin:secret@localhost:5432/multitenant?schema=public"

# For Docker Compose (running app inside Docker):
# DATABASE_URL="postgresql://admin:secret@postgres:5432/multitenant?schema=public"

# Application
PORT=3000
NODE_ENV=development

# JWT Configuration (for future auth module)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=1d

# Redis (if needed in future)
REDIS_HOST=localhost
REDIS_PORT=6379
